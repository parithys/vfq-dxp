    { "from": "milestone4", "to": "pay", "type": "default" },
    { "from": "pay", "to": "order_ready", "type": "default", "label": "payment confirmation" },
    { "from": "order_ready", "to": "ord_submit", "type": "yes", "label": "Yes" },
    { "from": "order_ready", "to": "pay", "type": "no", "label": "No" },
    { "from": "ord_submit", "to": "milestone5", "type": "default", "label": "submitted order" },
    { "from": "milestone5", "to": "net", "type": "default" },
    { "from": "net", "to": "fin", "type": "default", "label": "activation outcome" },
    { "from": "fin", "to": "end", "type": "default", "label": "billing update" }
