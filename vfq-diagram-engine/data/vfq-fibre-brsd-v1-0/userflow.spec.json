    { "from": "rfs_gate", "to": "rfs_blocked", "type": "no", "label": "No" },
    { "from": "rfs_blocked", "to": "addr", "type": "fallback", "label": "recapture address" },
    { "from": "addr_lock", "to": "ecc", "type": "default", "label": "locked address + tenancy doc" },
