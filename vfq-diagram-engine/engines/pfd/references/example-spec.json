    "Incident response runbook",
    "Audit logging enabled"
  ],
  "flow": [
    { "type": "start", "label": "Start" },
    { "type": "step", "id": "submit", "kind": "manual", "role": "👤 Business Owner", "title": "Submit Use Case",
      "desc": ["Describe purpose, data,", "stakeholders, success metrics"], "edgeLabel": "intake form" },
    { "type": "step", "id": "classify", "kind": "automated", "role": "⚡ Risk Engine", "title": "Risk Classification",
      "desc": ["Score against EU AI Act", "tiers + internal taxonomy"], "edgeLabel": "risk tier" },
    { "type": "step", "id": "ethics", "kind": "manual", "role": "👤 Ethics Committee", "title": "Ethics Review",
      "desc": ["Bias, fairness, privacy,", "human-impact assessment"], "edgeLabel": "findings" },
    { "type": "decision", "id": "approved", "title": "Approved?", "yesLabel": "Yes",
      "no": { "label": "Rejected" }, "noLabel": "No" },
    { "type": "step", "id": "deploy", "kind": "integration", "role": "🔗 MLOps Platform", "title": "Deploy Model",
      "desc": ["Register, sign,", "canary release to prod"], "edgeLabel": "live" },
    { "type": "step", "id": "monitor", "kind": "automated", "role": "⚡ Observability", "title": "Monitor & Audit",
      "desc": ["Drift, fairness,", "incident detection"] },
    { "type": "end", "label": "In Production" }
  ],
  "loops": [
    { "from": "monitor", "to": "classify", "style": "plain", "label": "drift detected → re-classify" }
  ],
  "cards": {
    "ioTable": [
      { "input": "Use case intake form, training data lineage, stakeholders",
        "output": "Risk tier classification, in-scope data map",
        "meaning": "Intake details are classified against the risk taxonomy to assign a governed risk tier." },
      { "input": "Risk tier, bias/fairness findings, human-impact notes",
        "output": "Ethics decision, mitigation conditions, sign-off",
        "meaning": "The ethics committee reviews the tiered case and returns an approve/reject decision with conditions." },
      { "input": "Approved model, deployment plan, monitors",
        "output": "Signed model artifact, live endpoint, audit trail",
        "meaning": "The approved model is registered, signed, and canary-released with drift and fairness monitoring." }
    ],
    "prerequisites": [
      "AI policy & risk taxonomy published",
      "Ethics committee chartered with quorum",
      "Model registry / MLOps platform",
      "Incident response runbook",
      "Audit logging enabled end-to-end"
    ],
    "io": [
      "Input: Use case intake form",
      "Input: Training data lineage",
      "Output: Risk tier classification",
      "Output: Ethics review findings",
      "Output: Signed model artifact + audit trail"
    ],
    "tools": [
      "Risk scoring engine (internal)",
      "MLOps platform (model registry, deploy)",
      "Observability stack (drift, fairness)",
      "Audit log store (immutable)"
    ]
