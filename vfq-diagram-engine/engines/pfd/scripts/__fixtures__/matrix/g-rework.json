{
  "title": "Rework Flow",
  "subtitle": "Negative branch returns to an earlier activity",
  "flow": [
    {
      "type": "start",
      "label": "Start"
    },
    {
      "type": "step",
      "id": "n1",
      "kind": "manual",
      "title": "Draft",
      "desc": [
        "Author drafts"
      ]
    },
    {
      "type": "step",
      "id": "n2",
      "kind": "manual",
      "title": "Review",
      "desc": [
        "Peer review"
      ]
    },
    {
      "type": "decision",
      "id": "d1",
      "title": [
        "Accepted?"
      ],
      "yesLabel": "Yes",
      "noLabel": "No",
      "no": {
        "label": "Returned"
      }
    },
    {
      "type": "step",
      "id": "n3",
      "kind": "automated",
      "title": "Publish",
      "desc": [
        "Publish artefact"
      ]
    },
    {
      "type": "end",
      "label": "Published"
    }
  ],
  "loops": [
    {
      "from": "n3",
