{
  "name": "vfq-dxp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:news": "node --use-system-ca scripts/sync-news.mjs",
    "predev": "node --use-system-ca scripts/sync-news.mjs --soft",
    "prebuild": "node --use-system-ca scripts/sync-news.mjs --soft",
    "dev": "PORT=${PORT:-5173} vite",
    "dev:tablet": "PORT=${PORT:-5174} vite",
    "dev:mobile": "PORT=${PORT:-5175} vite",
    "dev:all": "PORT=5173 npm run dev & PORT=5174 npm run dev:tablet & PORT=5175 npm run dev:mobile & wait",
    "open:web": "node scripts/open-views.mjs web",
    "open:tablet": "node scripts/open-views.mjs tablet",
    "open:mobile": "node scripts/open-views.mjs mobile",
    "open:all": "node scripts/open-views.mjs all",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.4.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
