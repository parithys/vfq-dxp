# Source document corpus — large binaries, kept out of git except where explicitly noted below
/data/*
!/data/CRM_Journeys_Final_Updated_with_Type.xlsx
!/data/Vodafone_Requirement_Hierarchy_Traceability_Template.xlsx

# Reference-only source corpus (screenshots, recordings, raw docs) — not consumed at runtime
/Application Screenshots/
/BRD/
# /BRSD/ moved into vfq-diagram-engine/ on 2026-09-27 - it is that engine's
# input corpus (its manifest.json records every entry as "BRSD/<file>.xlsx").
# Now ignored by vfq-diagram-engine/.gitignore instead of here.
/Business Documents/
/CAF (Customer Application Form)/
/CRM Journeys/
/Generated/
/Guided Journeys/
/Process Manuals/
/Workshop Recordings/

# Local session/tooling state
.claude/
.DS_Store

# Excel lock files (created while a workbook is open; 165-byte stubs)
~$*
# Local export/zip artefacts
*.zip
